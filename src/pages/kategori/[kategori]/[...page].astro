---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import Pager from '../../../components/Pager.astro';
import { getPosts, KATEGORI, CAT_SLUG } from '../../../lib/site';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPosts();
  return KATEGORI.flatMap((cat) =>
    paginate(posts.filter((p) => p.data.category === cat), {
      params: { kategori: CAT_SLUG[cat] },
      props: { cat },
      pageSize: 12,
    })
  );
}) satisfies GetStaticPaths;

const { page, cat } = Astro.props;
const blurb = cat === 'Cek Fakta'
  ? 'Klaim yang beredar, sudah kami periksa.'
  : `Berita ${cat} terbaru dari Faktavia.`;
---
<BaseLayout title={cat} description={blurb}>
  <section>
    <div class="wrap">
      <div class="page-head">
        <h1 class="sec" style="font-size: clamp(2rem, 5vw, 3rem); font-weight: 800; letter-spacing: -.03em;">{cat}</h1>
        <p>{blurb}</p>
      </div>
      {page.data.length > 0 ? (
        <div class="grid" style="margin-top: 22px;">{page.data.map((p) => <PostCard post={p} />)}</div>
      ) : (
        <p class="empty">Belum ada berita di kategori ini.</p>
      )}
      <Pager prev={page.url.prev} next={page.url.next} current={page.currentPage} last={page.lastPage} />
    </div>
  </section>
</BaseLayout>
