---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import sitrep from '../data/sitrep.json';

const all = await getCollection('insiden', ({ data }) => !data.hidden);
const insiden = all
  .sort((a, b) => b.data.time.valueOf() - a.data.time.valueOf())
  .map((e) => ({
    id: e.id,
    title: e.data.title,
    type: e.data.type,
    status: e.data.status,
    severity: e.data.severity,
    place: e.data.place,
    province: e.data.province ?? '',
    lat: e.data.lat,
    lng: e.data.lng,
    t: e.data.time.valueOf(),
    description: e.data.description,
    sourceName: e.data.sourceName ?? '',
    sourceUrl: e.data.sourceUrl ?? '',
    article: e.data.relatedArticle ? `/berita/${e.data.relatedArticle}/` : '',
  }));

const config = { insiden, cctv: sitrep.cctv, x: sitrep.x };
---
<BaseLayout
  title="Sitrep Faktavia: Pantauan Situasi Indonesia"
  description="Situation room Faktavia: peta insiden, wire berita, gempa BMKG, peringatan dini cuaca, titik panas, CCTV, dan pantauan demo, kebakaran, banjir, serta bencana di seluruh Indonesia."
>
  <section class="sr-hero">
    <div class="wrap">
      <div class="sr-top">
        <div>
          <span class="pill"><span class="dot live"></span>Situation Room</span>
          <h1 class="title">Sitrep <mark>Faktavia</mark></h1>
          <p class="lead">Pantauan situasi Indonesia dalam satu layar: demo, kebakaran, banjir, bencana, dan insiden lain. Data otomatis dari sumber resmi, catatan insiden diverifikasi redaksi.</p>
        </div>
        <div class="sr-status" aria-live="polite">
          <div class="sr-clock" id="srClock">--:--:--</div>
          <div class="sr-clock-sub">WIB · data diperbarui otomatis</div>
          <button class="btn btn-ghost sr-notif" id="srNotif" type="button">Aktifkan notifikasi gempa</button>
        </div>
      </div>

      <div class="sr-kpis">
        <div class="kpi"><small>Gempa terbaru</small><strong id="kGempa">…</strong><span id="kGempaSub">memuat</span></div>
        <div class="kpi"><small>Peringatan dini cuaca</small><strong id="kCuaca">…</strong><span id="kCuacaSub">memuat</span></div>
        <div class="kpi"><small>Titik panas (±48 jam)</small><strong id="kHot">…</strong><span id="kHotSub">memuat</span></div>
        <div class="kpi"><small>Insiden dipantau redaksi</small><strong id="kInsiden">…</strong><span id="kInsidenSub">memuat</span></div>
      </div>
    </div>
  </section>

  <section class="sr-main">
    <div class="wrap sr-grid">
      <article class="panel sr-map">
        <header>
          <h2>Peta Insiden</h2>
          <div class="layers" role="group" aria-label="Lapisan peta">
            <label><input type="checkbox" id="lyInsiden" checked /> Insiden</label>
            <label><input type="checkbox" id="lyGempa" checked /> Gempa</label>
            <label><input type="checkbox" id="lyHot" /> Titik panas</label>
          </div>
        </header>
        <div id="srMap" role="application" aria-label="Peta insiden di Indonesia"></div>
        <footer class="legend">
          <span><i class="d demo"></i>Demo</span><span><i class="d api"></i>Kebakaran</span><span><i class="d air"></i>Banjir</span>
          <span><i class="d bencana"></i>Bencana/Gempa</span><span><i class="d lain"></i>Lainnya</span>
          <span class="muted">Lingkaran gempa: ukuran = magnitudo</span>
        </footer>
      </article>

      <article class="panel sr-wire">
        <header>
          <h2>Wire Berita</h2>
          <span class="stamp" id="wireStamp"></span>
        </header>
        <div class="chips" id="wireChips" role="group" aria-label="Filter wire berita">
          <button class="chip active" data-tag="all" type="button">Semua</button>
          <button class="chip" data-tag="demo" type="button">Demo</button>
          <button class="chip" data-tag="kebakaran" type="button">Kebakaran</button>
          <button class="chip" data-tag="banjir" type="button">Banjir</button>
          <button class="chip" data-tag="bencana" type="button">Bencana</button>
        </div>
        <ul class="feed" id="wireList"><li class="state">Memuat wire berita…</li></ul>
        <p class="note">Hanya judul dan tautan ke media asal. Label topik dibuat otomatis dari kata kunci dan belum diverifikasi.</p>
      </article>

      <article class="panel sr-cctv">
        <header>
          <h2>CCTV</h2>
          <span class="stamp">Siaran dari kanal resmi</span>
        </header>
        <div class="tabs" id="cctvTabs" role="tablist" aria-label="Daftar CCTV"></div>
        <div class="cctv-stage" id="cctvStage">
          <p class="state">Pilih kamera di atas.</p>
        </div>
        <p class="note" id="cctvNote"></p>
      </article>

      <article class="panel sr-insiden">
        <header>
          <h2>Catatan Insiden Redaksi</h2>
          <span class="stamp">Diverifikasi manual</span>
        </header>
        <ul class="feed" id="insidenList"></ul>
      </article>

      <article class="panel sr-gempa">
        <header>
          <h2>Gempa Terkini</h2>
          <span class="stamp" id="gempaStamp"></span>
        </header>
        <ul class="feed compact" id="gempaList"><li class="state">Memuat data BMKG…</li></ul>
        <p class="note">Sumber: BMKG.</p>
      </article>

      <article class="panel sr-cuaca">
        <header>
          <h2>Peringatan Dini Cuaca</h2>
          <span class="stamp" id="cuacaStamp"></span>
        </header>
        <ul class="feed compact" id="cuacaList"><li class="state">Memuat peringatan BMKG…</li></ul>
        <p class="note">Sumber: BMKG. Detail per wilayah ada di tautan masing-masing peringatan.</p>
      </article>

      <article class="panel sr-x">
        <header>
          <h2>X Live</h2>
          <span class="stamp">Akun resmi pilihan</span>
        </header>
        <div class="tabs" id="xTabs" role="tablist" aria-label="Akun X"></div>
        <div class="x-stage" id="xStage">
          <button class="btn btn-navy" id="xLoad" type="button">Muat timeline X</button>
          <p class="note">Timeline dimuat dari X (pihak ketiga) hanya setelah kamu menekan tombol ini.</p>
        </div>
      </article>
    </div>
  </section>

  <section class="sr-disclaimer">
    <div class="wrap">
      <h2 class="sec"><small>Baca dulu</small>Cara membaca Sitrep</h2>
      <ul class="disc">
        <li><strong>Titik panas bukan konfirmasi kebakaran.</strong> Itu deteksi anomali panas oleh satelit NASA FIRMS (VIIRS). Bisa juga berasal dari pembakaran lahan atau sumber panas lain. Konfirmasi tetap dari instansi terkait.</li>
        <li><strong>Gempa dan peringatan dini</strong> berasal dari BMKG dan ditampilkan apa adanya. Untuk keputusan keselamatan, ikuti kanal resmi BMKG dan BPBD setempat.</li>
        <li><strong>Wire berita</strong> hanya menampilkan judul dan tautan dari media asal. Label topik bersifat otomatis.</li>
        <li><strong>Catatan insiden</strong> dibuat dan diperbarui manual oleh redaksi. Statusnya <em>Dipantau</em> (belum cukup sumber), <em>Terverifikasi</em>, atau <em>Mereda</em>. Lokasi di peta bisa berupa perkiraan.</li>
        <li><strong>CCTV</strong> ditampilkan dari kanal resmi pengelolanya. Jika layar kosong, situs sumber tidak mengizinkan ditampilkan di situs lain. Pakai tombol "Buka di tab baru".</li>
        <li>Ada informasi yang keliru? Kirim ke <a href="mailto:redaksi@faktavia.web.id">redaksi@faktavia.web.id</a>.</li>
      </ul>
    </div>
  </section>

  <script is:inline type="application/json" id="sitrep-config" set:html={JSON.stringify(config).replace(/</g, '\\u003c')} />
  <script>
    import '../scripts/sitrep.ts';
  </script>
</BaseLayout>

<style is:global>
  .sr-hero { padding: 28px 0 8px; }
  .sr-top { display: grid; gap: 22px; align-items: end; }
  @media (min-width: 900px) { .sr-top { grid-template-columns: 1.6fr 1fr; } }
  .sr-hero h1.title { font-size: clamp(2rem, 5vw, 3.2rem); margin: 10px 0 8px; }
  .dot.live { background: #E5484D; animation: srpulse 1.6s infinite; }
  @keyframes srpulse { 0% { box-shadow: 0 0 0 0 rgba(229,72,77,.55); } 70% { box-shadow: 0 0 0 9px rgba(229,72,77,0); } 100% { box-shadow: 0 0 0 0 rgba(229,72,77,0); } }
  .sr-status { text-align: left; }
  @media (min-width: 900px) { .sr-status { text-align: right; } }
  .sr-clock { font-size: clamp(1.9rem, 5vw, 2.8rem); font-weight: 800; letter-spacing: -.02em; font-variant-numeric: tabular-nums; color: var(--navy); }
  [data-theme="dark"] .sr-clock { color: #fff; }
  .sr-clock-sub { color: var(--muted); font-weight: 600; font-size: .85rem; margin-bottom: 10px; }
  .sr-notif { padding: 9px 16px; font-size: .85rem; }
  .sr-kpis { display: grid; gap: 14px; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); margin-top: 22px; }
  .kpi { background: var(--navy-d); color: #fff; border-radius: 18px; padding: 16px 18px; display: flex; flex-direction: column; gap: 4px; border: 1px solid rgba(255,255,255,.08); }
  .kpi small { color: var(--amber); font-weight: 800; letter-spacing: .08em; text-transform: uppercase; font-size: .7rem; }
  .kpi strong { font-size: 1.7rem; line-height: 1.1; font-weight: 800; font-variant-numeric: tabular-nums; }
  .kpi span { color: #B9C7DA; font-size: .82rem; line-height: 1.35; }

  .sr-main { padding-top: 22px; }
  .sr-grid { display: grid; gap: 18px; grid-template-columns: 1fr; }
  @media (min-width: 1000px) {
    .sr-grid { grid-template-columns: repeat(12, 1fr); }
    .sr-map { grid-column: span 8; }
    .sr-wire { grid-column: span 4; }
    .sr-cctv { grid-column: span 12; }
    .sr-insiden { grid-column: span 6; }
    .sr-gempa { grid-column: span 3; }
    .sr-cuaca { grid-column: span 3; }
    .sr-x { grid-column: span 12; }
  }
  .panel { background: var(--surface); border: 1px solid var(--line); border-radius: 20px; display: flex; flex-direction: column; min-width: 0; overflow: hidden; }
  .panel > header { display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap; padding: 14px 18px; border-bottom: 1px solid var(--line); }
  .panel > header h2 { font-size: 1rem; font-weight: 800; letter-spacing: -.01em; }
  .panel > header h2::before { content: ""; display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: var(--amber); margin-right: 9px; }
  .stamp { color: var(--muted); font-size: .76rem; font-weight: 600; }
  .note { color: var(--muted); font-size: .76rem; padding: 10px 18px 14px; line-height: 1.45; }
  .layers { display: flex; flex-wrap: wrap; gap: 4px 14px; font-size: .82rem; font-weight: 600; }
  .layers input { accent-color: var(--amber-d); margin-right: 5px; }

  #srMap { height: 460px; background: #dfe7f1; z-index: 0; }
  @media (min-width: 1000px) { #srMap { height: 560px; } }
  [data-theme="dark"] #srMap .leaflet-tile-pane { filter: invert(.92) hue-rotate(180deg) brightness(.9) contrast(.9); }
  .legend { display: flex; flex-wrap: wrap; gap: 6px 16px; padding: 10px 18px; border-top: 1px solid var(--line); font-size: .76rem; font-weight: 600; }
  .legend .muted { color: var(--muted); }
  .d { display: inline-block; width: 10px; height: 10px; border-radius: 50%; margin-right: 6px; vertical-align: -1px; }
  .d.demo { background: #E5484D; } .d.api { background: #F76B15; } .d.air { background: #0091FF; } .d.bencana { background: #8E4EC6; } .d.lain { background: #687076; }

  .sr-wire .chips { padding: 12px 18px 4px; gap: 6px; }
  .sr-wire .chip { padding: 6px 12px; font-size: .78rem; cursor: pointer; font-family: inherit; color: inherit; }
  .sr-wire .chip.active { color: #fff; }
  [data-theme="dark"] .sr-wire .chip.active { color: var(--navy-d); }
  .feed { list-style: none; margin: 0; padding: 6px 0; overflow-y: auto; max-height: 470px; }
  .sr-wire .feed { max-height: 420px; }
  .feed li { padding: 10px 18px; border-bottom: 1px solid var(--line); font-size: .88rem; line-height: 1.4; }
  .feed li:last-child { border-bottom: 0; }
  .feed li.state { color: var(--muted); text-align: center; padding: 26px 18px; }
  .feed a { font-weight: 700; }
  .feed a:hover { text-decoration: underline; }
  .feed .m { display: flex; flex-wrap: wrap; gap: 4px 10px; margin-top: 4px; color: var(--muted); font-size: .74rem; font-weight: 600; align-items: center; }
  .tagp { display: inline-block; padding: 2px 8px; border-radius: 999px; background: var(--amber-soft); color: var(--ink); font-weight: 800; font-size: .66rem; letter-spacing: .04em; text-transform: uppercase; }
  .st { display: inline-block; padding: 2px 8px; border-radius: 6px; font-weight: 800; font-size: .66rem; letter-spacing: .05em; text-transform: uppercase; }
  .st.Terverifikasi { background: #CFF3DC; color: #0F5A2C; } .st.Dipantau { background: #FFE9B8; color: #7A4A00; } .st.Mereda { background: #E2E8F1; color: #374151; }
  .mag { display: inline-block; min-width: 42px; text-align: center; padding: 3px 7px; border-radius: 8px; font-weight: 800; color: #fff; margin-right: 8px; font-variant-numeric: tabular-nums; }
  .mag.m1 { background: #3E8E5C; } .mag.m2 { background: #D9961A; } .mag.m3 { background: #D4441C; } .mag.m4 { background: #8A1C14; }
  .feed.compact li { padding: 9px 16px; }
  .err { color: #B42318; }
  .retry { margin-left: 8px; font-weight: 700; text-decoration: underline; cursor: pointer; background: none; border: 0; color: inherit; font-family: inherit; }

  .tabs { display: flex; flex-wrap: wrap; gap: 6px; padding: 12px 18px 4px; }
  .tabs button { padding: 7px 14px; border-radius: 999px; border: 1.5px solid var(--line); background: var(--surface); font-weight: 700; font-size: .82rem; cursor: pointer; font-family: inherit; color: inherit; }
  .tabs button[aria-selected="true"] { background: var(--navy); border-color: var(--navy); color: #fff; }
  [data-theme="dark"] .tabs button[aria-selected="true"] { background: var(--amber); border-color: var(--amber); color: var(--navy-d); }
  .cctv-stage { margin: 10px 18px 0; min-height: 360px; border-radius: 14px; background: #07162A; display: grid; place-items: center; overflow: hidden; position: relative; }
  .cctv-stage iframe, .cctv-stage video, .cctv-stage img { width: 100%; height: 560px; max-height: 70vh; border: 0; background: #000; object-fit: contain; }
  .cctv-stage .state { color: #B9C7DA; padding: 20px; text-align: center; max-width: 36em; }
  .cctv-actions { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; padding: 20px; }
  .cctv-actions .btn { padding: 10px 18px; font-size: .88rem; }
  .x-stage { padding: 14px 18px 8px; min-height: 120px; }
  .x-stage .note { padding-left: 0; }

  .sr-disclaimer { padding-top: 10px; }
  .disc { display: grid; gap: 10px; margin-top: 8px; max-width: 62em; color: var(--muted); font-size: .92rem; }
  .disc strong { color: var(--ink); }
  .disc a { text-decoration: underline; }

  .leaflet-popup-content { font-family: var(--font); font-size: 13px; line-height: 1.4; }
  .leaflet-popup-content a { color: #1B5CA3; font-weight: 700; text-decoration: underline; }
</style>
