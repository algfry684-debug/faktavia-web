---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Halaman tidak ditemukan" noindex>
  <section class="hero">
    <div class="wrap" style="text-align:center;">
      <span class="pill">Error 404</span>
      <h1 class="title">Yah, halamannya <mark>nggak ada</mark>.</h1>
      <p class="lead" style="margin-inline:auto;">Alamatnya mungkin salah ketik, atau beritanya sudah dipindah.</p>
      <div class="cta" style="justify-content:center;"><a class="btn btn-amber" href="/">Kembali ke Beranda</a></div>
    </div>
  </section>
</BaseLayout>
