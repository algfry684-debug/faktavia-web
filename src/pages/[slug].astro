---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const pages = await getCollection('halaman');
  return pages.map((page) => ({ params: { slug: page.id }, props: { page } }));
}

const { page } = Astro.props;
const { Content } = await render(page);
---
<BaseLayout title={page.data.title} description={page.data.description}>
  <article class="article">
    <p class="crumbs"><a href="/">Beranda</a> / {page.data.title}</p>
    <h1>{page.data.title}</h1>
    <div class="prose" style="margin-top: 22px;"><Content /></div>
  </article>
</BaseLayout>
